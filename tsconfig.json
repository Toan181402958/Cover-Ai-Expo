{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "components/*": ["src/components/*"],
      "modules/*": ["src/modules/*"],
      "assets/*": ["assets/*"],
      "utils/*": ["src/utils/*"],
      "constants/*": ["src/constants/*"],
      "src/*": ["src/*"],
    }
  }
}
